+/*
+ * Read-only UFS probe: the GPT walk and the first bytes only.  Runs off
+ * the boot path so a hung controller cannot keep PID 1 from starting.
+ */
+int
+sweet_ufs_probe(void)
+{
+	int error;
+
+	sweet_ufs_probe_only = true;
+	error = sweet_ufs_init();
+	sweet_ufs_probe_only = false;
+	printf("SWEET UFS: read-only probe %s (%d)\n", error ? "failed" : "ok", error);
+	return error;
+}
