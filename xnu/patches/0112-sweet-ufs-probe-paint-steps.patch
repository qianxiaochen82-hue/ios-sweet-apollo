 	su.cache = (cache == 1);
 	su.wait = (wait == 1);
 
+	sweet_ufs_probe_step("UFS: ml_io_map");
 	printf("SWEET UFS: probe: mapping regs\n");
 	su.regs = ml_io_map(reg[0], reg[1]);
 	printf("SWEET UFS: probe: regs at 0x%llx\n", (unsigned long long)(uintptr_t)su.regs);
+	sweet_ufs_probe_step("UFS: kmem_alloc_contig");
 	printf("SWEET UFS: probe: allocating DMA\n");
 	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
 	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
@@ -627,6 +646,7 @@ sweet_ufs_init(void)
 	su.lun = 0;
 	su.secsize = DEV_BSIZE;
 
+	sweet_ufs_probe_step("UFS: takeover");
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
 	printf("SWEET UFS: probe: takeover %s\n", error ? "failed" : "ok");
@@ -636,6 +656,7 @@ sweet_ufs_init(void)
 		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
 		}
 	}
+	sweet_ufs_probe_step("UFS: tur/gpt");
 	if (!error) {
 		error = ufs_find_partition(want);
 	}
@@ -684,6 +705,7 @@ sweet_ufs_probe(void)
 
 	sweet_ufs_probe_only = true;
 	error = sweet_ufs_init();
+	sweet_ufs_probe_step(error ? "UFS: failed" : "UFS: done");
