diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 638b9b2..daf9f8e 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -120,6 +120,23 @@ static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
 static boolean_t sweet_ufs_probe_only;	/* GPT walk only, no devices */
 
+/*
+ * Paint the step on the heartbeat row before touching the controller.  If the
+ * access stalls the CPU the heartbeat stops repainting, so the row keeps
+ * showing the last step that was reached.
+ */
+static void
+sweet_ufs_probe_step(const char *what)
+{
+	extern void sweet_status(const char *);
+
+	if (!sweet_ufs_probe_only) {
+		return;
+	}
+	printf("SWEET UFS: probe step %s\n", what);
+	sweet_status(what);
+}
+
 static inline uint32_t
 ufs_rd(uint32_t off)
 {
