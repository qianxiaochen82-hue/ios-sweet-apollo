 	kernel_bootstrap_log("PE_lockdown_iokit");
 	PE_lockdown_iokit();
+	sweet_fb_mark("IOKIT LD");
 #endif
 	/*
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
 	vm_set_restrictions(machine_info.max_cpus);
+	sweet_fb_mark("MAXCPUS");
 
 
 #if KPERF
@@ -840,6 +849,7 @@ kernel_bootstrap_thread(void)
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	sweet_fb_mark("PRE BSD");
 	kprintf("SWEET STAGE: calling bsd_init\n");
 	bsd_init();
