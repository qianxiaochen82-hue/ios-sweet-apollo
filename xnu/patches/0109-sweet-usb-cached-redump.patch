--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -72,8 +72,47 @@
 	__asm__ volatile ("dmb oshld" ::: "memory");
 	return v;
 }
 
+/*
+ * Cached by the single probe that root mount runs, so the heartbeat can
+ * re-print the values without touching the controller again: a second probe
+ * would soft-reset the running gadget and replace its DMA area.
+ */
+struct sweet_usb_dbg {
+	bool valid;
+	bool dwc_ok;
+	uint32_t gdscr;
+	uint32_t clk[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	uint32_t gsnpsid, gctl, gsts, gusb2phycfg;
+	uint32_t dcfg, dctl, devten, dsts, dalepena;
+};
+
+static struct sweet_usb_dbg usb_dbg;
+
+/*
+ * Heartbeat-safe report: prints the values above and touches no register.
+ * Called every 30 s from bsd_init.c's stage thread.
+ */
+void
+sweet_usb_redump(void)
+{
+	if (!usb_dbg.valid) {
+		printf("SWEET USBHOLD: probe has not run yet\n");
+		return;
+	}
+	printf("SWEET USBHOLD: GDSC 0x%08x mclk 0x%08x cfg 0x%08x\n",
+	    usb_dbg.gdscr, usb_dbg.clk[0], usb_dbg.clk[3]);
+	if (!usb_dbg.dwc_ok) {
+		printf("SWEET USBHOLD: DWC3 not read (power/clocks off)\n");
+		return;
+	}
+	printf("SWEET USBHOLD: GSNPSID 0x%08x DSTS 0x%08x DEVTEN 0x%08x DALEPENA 0x%08x\n",
+	    usb_dbg.gsnpsid, usb_dbg.dsts, usb_dbg.devten, usb_dbg.dalepena);
+	printf("SWEET USBHOLD: DCFG 0x%08x DCTL 0x%08x GCTL 0x%08x\n",
+	    usb_dbg.dcfg, usb_dbg.dctl, usb_dbg.gctl);
+}
+
 void
 sweet_usb_probe(void)
 {
 	int enabled = 1;
@@ -93,8 +132,11 @@
