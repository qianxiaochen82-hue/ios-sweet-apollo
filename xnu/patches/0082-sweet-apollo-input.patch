diff --git b/bsd/dev/apollo_keys.c b/bsd/dev/apollo_keys.c
new file mode 100644
index 0000000..05942d0
--- /dev/null
+++ b/bsd/dev/apollo_keys.c
@@ -0,0 +1,205 @@
+/*
+ * apollo (Redmi K30S Ultra / SM8250 "kona") keys.
+ *
+ * Facts taken from the vendor tree
+ * (drivers/input/touchscreen/nt36672c, arch/arm64/boot/dts/venor/qcom):
+ *   - power  : PM8150 (SID 0) PON KPDPWR, PON_RT_STS at SPMI 0x810 bit0
+ *   - vol up : PM8150 (SID 0) GPIO6, active low ("vol_up" in
+ *              xiaomi-sm8250-common.dtsi, key_vol_up_default under
+ *              &pm8150_gpios; /proc/interrupts shows "pmic_arb volume_up")
+ *   - vol dn : no GPIO anywhere in the 27 dtbo fragments; PM8150 RESIN
+ *              (PON_RT_STS bit1) is the only remaining wired key.
+ *
+ * PMIC access is READ ONLY: the only MMIO write issues EXT_READL on an
+ * arbiter observer channel.  No PMIC config, IRQ acknowledge or reset
+ * writes exist here.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void apollo_keys_init(void);
+
+/* kona SPMI arbiter v5 (APPS RSC): same layout as sweet, different base. */
+#define KEYS_CORE_PA     0x0c440000u
+#define KEYS_OBS_PA      0x0e600000u
+#define KEYS_CNFG_PA     0x0c40a000u
+#define KEYS_PON_PPID    0x008u   /* PM8150 PON   @ 0x800 */
+#define KEYS_GPIO_PPID   0x0c0u   /* PM8150 GPIO  @ 0xc000 */
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_STRIDE 0x100u
+#define KEYS_GPIO6       (6u * KEYS_GPIO_STRIDE)  /* 0xc600 */
+#define KEYS_GPIO_RT     0x0au    /* PMIC5 GPIO pin status */
+#define KEYS_NO_APID     0xffffu
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_dump_map(uint32_t count)
+{
+	printf("SWEET KEYS(apollo): arbiter ppid map, %u entries:\n", count);
+	for (uint32_t i = 0; i < count && i < 48; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0) {
+			continue;
+		}
+		printf("  apid%u ppid=%#x owner=%u\n", i, (map >> 8) & 0xfffu,
+		    keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u);
+	}
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO6 + KEYS_GPIO_RT, &gpio);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("SWEET KEYS(apollo): read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS(apollo): key=%d down=%d pon=%#x gpio6=%#x\n",
+				    k, state[k], pon, gpio);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+apollo_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS(apollo): disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS(apollo): MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("SWEET KEYS(apollo): unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(KEYS_PON_PPID, count);
+	keys_gpio_apid = keys_find_apid(KEYS_GPIO_PPID, count);
+	if (keys_gpio_apid == KEYS_NO_APID) {
+		/* PM8150 GPIO may be decoded one slot higher (see PM6150L: 0xc1). */
+		keys_gpio_apid = keys_find_apid(KEYS_GPIO_PPID + 1u, count);
+	}
+	uint8_t pon = 0, gpio = 0, gpio_alt = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO6 + KEYS_GPIO_RT, &gpio);
+	bool aok = keys_read(keys_gpio_apid, KEYS_GPIO6 + 0x10u, &gpio_alt);
+	printf("SWEET KEYS(apollo): arb=%#x apids=%u pon-apid=%u gpio-apid=%u pon=%#x/%d gpio6[0x0a]=%#x/%d gpio6[0x10]=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	    pon, pok, gpio, gok, gpio_alt, aok);
+	if (!pok) {
+		keys_dump_map(count);
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS(apollo): kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git b/bsd/dev/apollo_touch.c b/bsd/dev/apollo_touch.c
new file mode 100644
index 0000000..1658195
--- /dev/null
+++ b/bsd/dev/apollo_touch.c
@@ -0,0 +1,607 @@
+/*
+ * apollo (Redmi K30S Ultra / SM8250 "kona") Novatek NT36675 touch.
+ *
+ * Ported from the vendor driver in
+ * Xiaomi_Kernel_OpenSource-apollo-q-oss/drivers/input/touchscreen/nt36672c:
+ *
+ *   nvt_set_page()        {0xFF, addr>>15, addr>>7}
+ *   nvt_write_addr()      {0x80 | (addr & 0x7F), data} after set_page
+ *   CTP_SPI_READ()        tx {0x00 | (addr & 0x7F)}, rx has one dummy byte,
+ *                         data starts at rbuf[2]  (DUMMY_BYTES = 1)
+ *   nvt_sw_reset_idle()   0xAA -> SWRST_N8_ADDR  0x3F0FE
+ *   nvt_bootloader_reset()0x69 -> SWRST_N8_ADDR  0x3F0FE, then
+ *                         0x00 -> SPI_RD_FAST_ADDR 0x3F310
+ *   nvt_get_fw_info()     page 0x22D00|EVENT_MAP_FWINFO (0x78), read 17 bytes:
+ *                         fw_ver, ~fw_ver, x_num, y_num, xmax(2), ymax(2), ...
+ *   nvt_ts_check_chip_ver_trim() page 0x1F600, command 0x4E, 6 id bytes
+ *   report (protocol B)   read POINT_DATA_LEN(65) bytes; slot i at 6*i:
+ *                         {id<<3|status, xh, yh, xy, w, ?},
+ *                         x = xh<<4 | xy>>4, y = yh<<4 | xy&0xF,
+ *                         down when status is 1 (enter) or 2 (move)
+ *
+ * Transport: polled GENI SPI (QUPv3 wrapper 0, SE4 at 0x990000), 8 bit words,
+ * mode 0, 10 MHz.  The vendor dtsi says spi-max-frequency = <10000000> and the
+ * vendor kernel logs "tx_fifo 16 rx_fifo 16 tx_width 32"; every transfer here
+ * stays <= 16 bytes and no DMA is needed.
+ *
+ * Data-ready is the touch INT line on TLMM gpio39 (vendor DT
+ * novatek,irq-gpio = <&tlmm 39 0x2001>; /proc/interrupts lists it as
+ * "NVT-ts-spi" under msmgpio, 378 interrupts on CPU0).  That is a GPIO edge,
+ * not the SE's own GIC interrupt 605, so this driver watches the pin and only
+ * starts a SPI read while the line is asserted.
+ *
+ * Board facts (arch/arm64/boot/dts/venor/qcom/apollo-sm8250.dtsi,
+ * /proc/interrupts and dmesg on the live phone):
+ *   spi@990000, pins gpio8..11 = "qup4", TLMM 0x0f000000,
+ *   touch VDDIO = tlmm gpio69 (active high), reset = gpio38, irq = gpio39,
+ *   vdd_boost = pm8150b gpio5 (already always-on in the vendor tree).
+ *
+ * No firmware upload and no RPMh vote is performed.  /vendor/firmware has no
+ * Novatek .bin (only NT36xxx_MP_Setting_Criteria_593C.csv) and neither does
+ * /vendor/firmware_mnt, while the kernel source ships
+ * novatek_nt36675_j3s_fw01.bin.ihex, so the firmware lives in the chip's own
+ * flash and the vendor probe never downloads one either.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void apollo_touch_init(void);
+
+#define TSP_TLMM_PA     0x0f000000u
+#define TSP_GCC_PA      0x00100000u
+#define TSP_SE_PA       0x00990000u
+
+/* TLMM: cfg = base + 0x1000*n (mux[5:2] drive[8:6] oe[9] pull[1:0]),
+ *        io  = cfg + 4 (in bit0, out bit1). */
+#define TL_CFG(n)       ((uint32_t)(n) * 0x1000u)
+#define TL_IO(n)        (TL_CFG(n) + 4u)
+
+/* GCC: wrapper 0 SE4 branch + its m-ahb gate share one CBCR. */
+#define GCC_CBCR_WRAP0      0x52008u
+#define GCC_CBCR_S4         (1u << 14)
+#define GCC_CBCR_M_AHB      (1u << 6)
+#define GCC_RCG_WRAP0_S4_CMD 0x174d0u
+#define GCC_RCG_WRAP0_S4_CFG 0x174d4u
+#define RCG_UPDATE          (1u << 0)
+#define RCG_ROOT_EN         (1u << 1)
+#define RCG_SRC_SEL(s)      ((uint32_t)(s) << 8)
+#define RCG_MODE_BYPASS     (0u << 12)
+#define P_GPLL0_OUT_EVEN    2u   /* gcc_parent_names_0[]: bi_tcxo, gpll0, ... */
+
+/* GENI SE (common block), offsets from include/linux/qcom-geni-se.h */
+#define SE_GENI_FORCE_DEF   0x020u
+#define SE_GENI_OUTPUT_CTRL 0x024u
+#define SE_GENI_CGC_CTRL    0x028u
+#define SE_GENI_STATUS      0x040u
+#define SE_GENI_SER_M_CLK   0x048u
+#define SE_GENI_CLK_SEL     0x07cu
+#define SE_GENI_DMA_MODE    0x258u
+#define SE_GENI_M_CMD0      0x600u
+#define SE_GENI_M_CMD_CTRL  0x604u
+#define SE_GENI_M_IRQ_STAT  0x610u
+#define SE_GENI_M_IRQ_EN    0x614u
+#define SE_GENI_M_IRQ_CLR   0x618u
+#define SE_GENI_TX_FIFO     0x700u
+#define SE_GENI_RX_FIFO     0x780u
+#define SE_GENI_TX_FIFO_ST  0x800u
+#define SE_GENI_RX_FIFO_ST  0x804u
+#define SE_GENI_TX_WM       0x80cu
+#define SE_GENI_RX_WM       0x810u
+#define SE_GENI_RX_RFR_WM   0x814u
+#define SE_GSI_EVENT_EN     0xe18u
+#define SE_IRQ_EN           0xe1cu
+#define SE_DMA_GENERAL_CFG  0xe30u
+#define CGC_ON_ALL          0x7fu   /* DEFAULT_CGC_EN */
+#define OUT_CTRL_DEFAULT    0x7fu   /* DEFAULT_IO_OUTPUT_CTRL_MSK */
+#define DMA_GENERAL_ON      0x0fu
+
+/* GENI SPI block */
+#define SE_SPI_CPHA         0x224u
+#define SE_SPI_LOOPBACK     0x22cu
+#define SE_SPI_CPOL         0x230u
+#define SE_SPI_DEMUX_SEL    0x250u
+#define SE_SPI_TRANS_CFG    0x25cu
+#define SE_SPI_WORD_LEN     0x268u
+#define SE_SPI_TX_LEN       0x26cu
+#define SE_SPI_RX_LEN       0x270u
+#define SE_SPI_DELAYS       0x278u
+#define SE_SPI_SLAVE_EN     0x2bcu
+
+#define M_CMD_DONE          (1u << 0)
+#define M_CMD_ERRORS        ((1u << 1) | (1u << 2) | (1u << 3))
+#define M_IRQ_EN_BITS       0xfu
+#define M_CMD_CLEAR         0xffffffffu
+#define OP_TX               1u
+#define OP_RX               2u
+#define OP_TX_RX            7u
+#define OP_CS_ASSERT        8u
+#define OP_CS_DEASSERT      9u
+
+#define TSP_FIFO_DEPTH      16u     /* vendor dmesg: tx_fifo 16 rx_fifo 16 */
+#define TSP_CHUNK           TSP_FIFO_DEPTH
+#define TSP_ENG_RST         0x7fff80u   /* ENG_RST_ADDR in nt36xxx.c */
+#define TSP_SWRST_N8        0x3f0feu
+#define TSP_RD_FAST         0x3f310u
+#define TSP_TRIM_ADDR       0x1f600u
+#define TSP_EVENT_BUF       0x22d00u
+#define TSP_FWINFO_OFF      0x78u
+#define TSP_POINT_LEN       65u     /* POINT_DATA_LEN, protocol B */
+#define TSP_MAX_FINGER      10
+
+static struct {
+	vm_offset_t se, gcc, tlmm;
+	bool up;
+	int sleep_chan;
+	uint32_t last_irq;
+	int xmax, ymax;
+	int x[TSP_MAX_FINGER], y[TSP_MAX_FINGER];
+} tsp;
+
+static uint32_t
+tsp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+tsp_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+tsp_delay(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&tsp.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+tsp_gpio_dir_out(unsigned pin, unsigned val)
+{
+	uint32_t cfg = tsp_rd(tsp.tlmm, TL_CFG(pin));
+	if (cfg == 0xffffffffu) {
+		return false;
+	}
+	/* plain GPIO function, output enable, then the level */
+	tsp_wr(tsp.tlmm, TL_CFG(pin), (cfg & ~(0xfu << 2)) | (1u << 9));
+	uint32_t io = tsp_rd(tsp.tlmm, TL_IO(pin));
+	io &= ~2u;
+	io |= (val ? 2u : 0u);
+	tsp_wr(tsp.tlmm, TL_IO(pin), io);
+	return true;
+}
+
+static uint32_t
+tsp_gpio_in(unsigned pin)
+{
+	return tsp_rd(tsp.tlmm, TL_IO(pin)) & 1u;
+}
+
+/*
+ * gpio39 is the touch INT (vendor DT: novatek,irq-gpio = <&tlmm 39 0x2001>,
+ * active low, pull down).  It is a msmgpio pin, not the SE's GIC interrupt
+ * 605, so configure it as a plain input and watch the level here.
+ */
+static void
+tsp_irq_gpio_init(void)
+{
+	uint32_t cfg = tsp_rd(tsp.tlmm, TL_CFG(39));
+	if (cfg == 0xffffffffu) {
+		printf("SWEET TOUCH: gpio39 not accessible\n");
+		return;
+	}
+	/* mux = gpio (0), output disabled (oe=0), pull down (DT 0x2001) */
+	cfg &= ~((0xfu << 2) | (1u << 9));
+	cfg = (cfg & ~0x3u) | 0x1u;
+	tsp_wr(tsp.tlmm, TL_CFG(39), cfg);
+	printf("SWEET TOUCH: irq gpio39 cfg=%#x level=%u (msmgpio edge, no GIC 605)\n",
+	    tsp_rd(tsp.tlmm, TL_CFG(39)), tsp_gpio_in(39));
+}
+
+/* Asserted (low) means the controller has a report to hand over. */
+static bool
+tsp_irq_asserted(void)
+{
+	return tsp_gpio_in(39) == 0;
+}
+
+static void
+tsp_mux_qup4(void)
+{
+	/* gpio8..11 carry "qup4"; pinctrl-kona.c PINGROUP(8..11, NORTH, qup4)
+	 * puts qup4 at function index 1 (index 0 is plain gpio). */
+	for (unsigned pin = 8; pin <= 11; ++pin) {
+		uint32_t cfg = tsp_rd(tsp.tlmm, TL_CFG(pin));
+		uint32_t mux = (cfg >> 2) & 0xfu;
+		if (cfg == 0xffffffffu) {
+			continue;
+		}
+		if (mux != 1u) {
+			tsp_wr(tsp.tlmm, TL_CFG(pin), (cfg & ~(0xfu << 2)) | (1u << 2));
+		}
+		printf("SWEET TOUCH: gpio%u cfg=%#x mux=%u -> %#x\n", pin, cfg, mux,
+		    tsp_rd(tsp.tlmm, TL_CFG(pin)));
+	}
+}
+
+static bool
+tsp_clock_on(void)
+{
+	uint32_t cbcr = tsp_rd(tsp.gcc, GCC_CBCR_WRAP0);
+	if ((cbcr & (GCC_CBCR_S4 | GCC_CBCR_M_AHB)) !=
+	    (GCC_CBCR_S4 | GCC_CBCR_M_AHB)) {
+		tsp_wr(tsp.gcc, GCC_CBCR_WRAP0,
+		    cbcr | GCC_CBCR_S4 | GCC_CBCR_M_AHB);
+	}
+	/* SE clock source: bypass gpll0_out_even (150 MHz) so the divider math
+	 * below is exact.  Writing CFG also drops CFG_HW_CLK_CTRL (bit 20),
+	 * which the boot chain may have set.  Root enable last. */
+	tsp_wr(tsp.gcc, GCC_RCG_WRAP0_S4_CFG, RCG_SRC_SEL(P_GPLL0_OUT_EVEN) |
+	    RCG_MODE_BYPASS);
+	tsp_wr(tsp.gcc, GCC_RCG_WRAP0_S4_CMD, RCG_UPDATE);
+	tsp_wr(tsp.gcc, GCC_RCG_WRAP0_S4_CMD, RCG_UPDATE | RCG_ROOT_EN);
+	printf("SWEET TOUCH: gcc cbcr=%#x rcg-cmd=%#x rcg-cfg=%#x\n",
+	    tsp_rd(tsp.gcc, GCC_CBCR_WRAP0),
+	    tsp_rd(tsp.gcc, GCC_RCG_WRAP0_S4_CMD),
+	    tsp_rd(tsp.gcc, GCC_RCG_WRAP0_S4_CFG));
+	return true;
+}
+
+static bool
+tsp_wait_done(void)
+{
+	for (unsigned i = 0; i < 500; ++i) {
+		uint32_t s = tsp_rd(tsp.se, SE_GENI_M_IRQ_STAT);
+		if (s & M_CMD_ERRORS) {
+			tsp.last_irq = s;
+			tsp_wr(tsp.se, SE_GENI_M_IRQ_CLR, M_CMD_CLEAR);
+			return false;
+		}
+		if (s & M_CMD_DONE) {
+			tsp.last_irq = s;
+			tsp_wr(tsp.se, SE_GENI_M_IRQ_CLR, M_CMD_CLEAR);
+			return true;
+		}
+		delay(1);
+	}
+	tsp.last_irq = tsp_rd(tsp.se, SE_GENI_M_IRQ_STAT);
+	return false;
+}
+
+static bool
+tsp_cmd(uint32_t opcode)
+{
+	tsp_wr(tsp.se, SE_GENI_M_IRQ_CLR, M_CMD_CLEAR);
+	tsp_wr(tsp.se, SE_GENI_M_CMD0, opcode << 27);
+	return tsp_wait_done();
+}
+
+/* One SPI transaction, <= TSP_CHUNK bytes, chip select asserted around it. */
+static bool
+tsp_xfr(const uint8_t *tx, unsigned tlen, uint8_t *rx, unsigned rlen)
+{
+	unsigned len = tlen > rlen ? tlen : rlen;
+	if (len == 0 || len > TSP_CHUNK) {
+		return false;
+	}
+	if (!tsp_cmd(OP_CS_ASSERT)) {
+		return false;
+	}
+	tsp_wr(tsp.se, SE_SPI_TX_LEN, tlen);
+	tsp_wr(tsp.se, SE_SPI_RX_LEN, rlen);
+	tsp_wr(tsp.se, SE_GENI_M_IRQ_CLR, M_CMD_CLEAR);
+	tsp_wr(tsp.se, SE_GENI_M_CMD0, (rlen ? OP_TX_RX : OP_TX) << 27);
+	for (unsigned i = 0; i < tlen; ++i) {
+		tsp_wr(tsp.se, SE_GENI_TX_FIFO, tx[i]);
+	}
+	bool ok = tsp_wait_done();
+	if (ok && rx) {
+		for (unsigned i = 0; i < rlen; ++i) {
+			rx[i] = (uint8_t)tsp_rd(tsp.se, SE_GENI_RX_FIFO);
+		}
+	}
+	(void)tsp_cmd(OP_CS_DEASSERT);
+	return ok;
+}
+
+static bool
+tsp_se_init(void)
+{
+	/* Mirrors geni_se_io_init() + geni_se_init() + geni_se_select_fifo_mode()
+	 * from drivers/soc/qcom/qcom-geni-se.c. */
+	uint32_t v;
+	v = tsp_rd(tsp.se, SE_GENI_CGC_CTRL);
+	tsp_wr(tsp.se, SE_GENI_CGC_CTRL, v | CGC_ON_ALL);
+	v = tsp_rd(tsp.se, SE_DMA_GENERAL_CFG);
+	tsp_wr(tsp.se, SE_DMA_GENERAL_CFG, v | DMA_GENERAL_ON);
+	tsp_wr(tsp.se, SE_GENI_OUTPUT_CTRL, OUT_CTRL_DEFAULT);
+	tsp_wr(tsp.se, SE_GENI_FORCE_DEF, 1);
+	tsp_wr(tsp.se, SE_GSI_EVENT_EN, 0);
+	tsp_wr(tsp.se, SE_GENI_M_IRQ_CLR, M_CMD_CLEAR);
+	tsp_wr(tsp.se, SE_GENI_M_IRQ_EN, M_IRQ_EN_BITS);
+	tsp_wr(tsp.se, SE_IRQ_EN, 0xfu);
+	tsp_wr(tsp.se, SE_GENI_DMA_MODE, 0);
+	tsp_wr(tsp.se, SE_GENI_TX_WM, 0);
+	tsp_wr(tsp.se, SE_GENI_RX_WM, 0);
+	tsp_wr(tsp.se, SE_GENI_RX_RFR_WM, TSP_FIFO_DEPTH - 2);
+	tsp_wr(tsp.se, SE_SPI_LOOPBACK, 0);   /* normal mode */
+	tsp_wr(tsp.se, SE_SPI_CPHA, 0);       /* mode 0 */
+	tsp_wr(tsp.se, SE_SPI_CPOL, 0);
+	tsp_wr(tsp.se, SE_SPI_DEMUX_SEL, 0);  /* chip select 0 */
+	tsp_wr(tsp.se, SE_SPI_TRANS_CFG, 0);  /* no CS toggle per word */
+	tsp_wr(tsp.se, SE_SPI_WORD_LEN, (8u - 4u) & 0x3ffu);
+	tsp_wr(tsp.se, SE_SPI_DELAYS, 0);
+	tsp_wr(tsp.se, SE_SPI_SLAVE_EN, 0);
+	tsp_wr(tsp.se, SE_GENI_CLK_SEL, 0);   /* clk_sel = 0 */
+	/* 150 MHz / 15 = 10 MHz, matching spi-max-frequency = <10000000>. */
+	tsp_wr(tsp.se, SE_GENI_SER_M_CLK, (15u << 4) | 1u);
+	printf("SWEET TOUCH: se status=%#x clk=%#x word=%#x fifo=%u/%u\n",
+	    tsp_rd(tsp.se, SE_GENI_STATUS),
+	    tsp_rd(tsp.se, SE_GENI_SER_M_CLK),
+	    tsp_rd(tsp.se, SE_SPI_WORD_LEN),
+	    TSP_FIFO_DEPTH, TSP_FIFO_DEPTH);
+	return tsp_rd(tsp.se, SE_GENI_STATUS) != 0xffffffffu;
+}
+
+static bool
+nt_page(uint32_t addr)
+{
+	uint8_t b[3] = {0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return tsp_xfr(b, 3, NULL, 0);
+}
+
+static bool
+nt_write(uint32_t addr, uint8_t val)
+{
+	uint8_t b[2] = {(uint8_t)(0x80 | (addr & 0x7f)), val};
+	if (!nt_page(addr)) {
+		return false;
+	}
+	return tsp_xfr(b, 2, NULL, 0);
+}
+
+static bool
+nt_read(uint32_t addr, uint8_t *out, unsigned len)
+{
+	unsigned done = 0;
+	while (done < len) {
+		unsigned n = len - done;
+		uint8_t tx[TSP_CHUNK], rx[TSP_CHUNK];
+		if (n > TSP_CHUNK - 2) {
+			n = TSP_CHUNK - 2;
+		}
+		if (!nt_page(addr + done)) {
+			return false;
+		}
+		/* read framing: 2 clocks of latency (echo + dummy) before data */
+		for (unsigned i = 0; i < TSP_CHUNK; ++i) {
+			tx[i] = 0;
+		}
+		tx[0] = (uint8_t)((addr + done) & 0x7f);
+		if (!tsp_xfr(tx, n + 2, rx, n + 2)) {
+			return false;
+		}
+		for (unsigned i = 0; i < n; ++i) {
+			out[done + i] = rx[i + 2];
+		}
+		done += n;
+	}
+	return true;
+}
+
+static void
+tsp_reset(void)
+{
+	/* Vendor probe order: hold TP_RESX low, send the engineering reset
+	 * command (nvt_eng_reset), release reset, wait 10 ms, then let
+	 * nvt_ts_check_chip_ver_trim() issue the bootloader reset. */
+	(void)tsp_gpio_dir_out(38, 0);
+	tsp_delay(1);
+	(void)nt_write(TSP_ENG_RST, 0x5a);   /* MCU idle, ENG_RST_ADDR */
+	tsp_delay(1);
+	(void)tsp_gpio_dir_out(38, 1);
+	tsp_delay(10);
+	(void)nt_write(TSP_SWRST_N8, 0x69);  /* bootloader reset */
+	tsp_delay(5);                        /* tBRST2FR */
+	(void)nt_write(TSP_RD_FAST, 0x00);   /* disable fast read */
+	tsp_delay(1);
+}
+
+/* nvt_ts_check_chip_ver_trim(): page 0x1F600, command 0x4E, 6 id bytes. */
+static bool
+tsp_chip_id(void)
+{
+	uint8_t b[6];
+	if (!nt_read(TSP_TRIM_ADDR | 0x4e, b, sizeof(b))) {
+		return false;
+	}
+	printf("SWEET TOUCH: chip id %02x %02x %02x %02x %02x %02x\n",
+	    b[0], b[1], b[2], b[3], b[4], b[5]);
+	return true;
+}
+
+static bool
+tsp_fw_info(uint16_t *xmax, uint16_t *ymax, uint8_t *ver)
+{
+	uint8_t b[17];
+	if (!nt_read(TSP_EVENT_BUF | TSP_FWINFO_OFF, b, sizeof(b))) {
+		return false;
+	}
+	printf("SWEET TOUCH: fwinfo %02x %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8],
+	    b[9], b[10], b[11], b[12], b[13], b[14], b[15], b[16]);
+	/* Vendor layout: fw_ver, ~fw_ver, x_num, y_num, xmax(2), ymax(2),
+	 * ... max_button_num at index 9. */
+	if ((uint8_t)(b[0] + b[1]) != 0xffu) {
+		return false;
+	}
+	*ver = b[0];
+	*xmax = (uint16_t)((b[4] << 8) | b[5]);
+	*ymax = (uint16_t)((b[6] << 8) | b[7]);
+	return true;
+}
+
+/*
+ * The vendor probe calls nvt_get_fw_info() several times and only trusts a
+ * value that stays put; require two consecutive identical valid reads so a
+ * half-updated event buffer cannot feed us bogus xmax/ymax.
+ */
+#define TSP_FWINFO_TRIES    5
+
+static bool
+tsp_fw_info_stable(uint16_t *xmax, uint16_t *ymax, uint8_t *ver)
+{
+	uint16_t lx = 0, ly = 0;
+	uint8_t lv = 0;
+	bool last = false;
+
+	for (int i = 0; i < TSP_FWINFO_TRIES; ++i) {
+		uint16_t x = 0, y = 0;
+		uint8_t v = 0;
+		bool ok = tsp_fw_info(&x, &y, &v);
+		if (ok && last && x == lx && y == ly && v == lv) {
+			*xmax = x;
+			*ymax = y;
+			*ver = v;
+			return true;
+		}
+		lx = x;
+		ly = y;
+		lv = v;
+		last = ok;
+		tsp_delay(10);
+	}
+	return false;
+}
+
+static void
+tsp_thread(void *arg, wait_result_t result)
+{
+	int prev[TSP_MAX_FINGER];
+	int last_mask = -1;
+	(void)arg;
+	(void)result;
+	for (int i = 0; i < TSP_MAX_FINGER; ++i) {
+		prev[i] = 0;
+	}
+	for (;;) {
+		/* Only read while the gpio39 INT line is asserted (active low);
+		 * this is the same report the vendor's threaded handler reads. */
+		if (!tsp_irq_asserted()) {
+			tsp_delay(1);
+			continue;
+		}
+		/* Protocol B: point_data[1 + 6*i] carries {id << 3 | status}. */
+		uint8_t buf[TSP_POINT_LEN];
+		if (nt_read(TSP_EVENT_BUF, buf, sizeof(buf))) {
+			int mask = 0;
+			for (int i = 0; i < TSP_MAX_FINGER; ++i) {
+				const uint8_t *d = &buf[i * 6];
+				unsigned id = d[0] >> 3;
+				unsigned status = d[0] & 0x07;
+				bool down = (id == (unsigned)i + 1u) &&
+				    (status == 1u || status == 2u);
+				int x = 0, y = 0;
+				if (down) {
+					x = (d[1] << 4) | (d[3] >> 4);
+					y = (d[2] << 4) | (d[3] & 0x0f);
+					if ((unsigned)x > tsp.xmax ||
+					    (unsigned)y > tsp.ymax) {
+						down = false;
+					}
+				}
+				if (down) {
+					mask |= 1 << i;
+				}
+				if (down != !!prev[i] ||
+				    (down && (x != tsp.x[i] || y != tsp.y[i]))) {
+					prev[i] = down;
+					tsp.x[i] = x;
+					tsp.y[i] = y;
+					sweet_hid_touch(i, down, x, y);
+				}
+			}
+			if (mask != last_mask) {
+				printf("SWEET TOUCH: mask=%#x\n", mask);
+				last_mask = mask;
+			}
+			tsp_delay(1);
+		} else {
+			tsp_delay(4);
+		}
+	}
+}
+
+void
+apollo_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	uint16_t xmax = 0, ymax = 0;
+	uint8_t ver = 0;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET TOUCH(apollo): disabled (sweettouch=0)\n");
+		return;
+	}
+	tsp.tlmm = ml_io_map(TSP_TLMM_PA, 0x100000);
+	tsp.gcc = ml_io_map(TSP_GCC_PA, 0x20000);
+	tsp.se = ml_io_map(TSP_SE_PA, 0x4000);
+	if (!tsp.tlmm || !tsp.gcc || !tsp.se) {
+		printf("SWEET TOUCH(apollo): MMIO mapping failed\n");
+		return;
+	}
+	printf("SWEET TOUCH(apollo): tlmm=%p gcc=%p se=%p\n", (void *)tsp.tlmm,
+	    (void *)tsp.gcc, (void *)tsp.se);
+	(void)tsp_gpio_dir_out(69, 1);   /* touch vddio, active high */
+	tsp_delay(20);
+	tsp_mux_qup4();
+	tsp_irq_gpio_init();
+	(void)tsp_clock_on();
+	if (!tsp_se_init()) {
+		printf("SWEET TOUCH(apollo): SE not responding, irq=%#x\n", tsp.last_irq);
+		return;
+	}
+	/*
+	 * The vendor probe reads FWINFO repeatedly and trusts it once the value
+	 * is stable.  There is no firmware download here either: /vendor/firmware
+	 * and /vendor/firmware_mnt carry no Novatek .bin and the vendor kernel
+	 * logs no download, so the chip's own flash already holds the firmware.
+	 */
+	if (!tsp_fw_info_stable(&xmax, &ymax, &ver)) {
+		printf("SWEET TOUCH(apollo): no valid fw info, doing vendor reset sequence\n");
+		tsp_reset();
+		(void)tsp_chip_id();
+		if (!tsp_fw_info_stable(&xmax, &ymax, &ver)) {
+			printf("SWEET TOUCH(apollo): still no valid fw info "
+			    "(irq=%#x, gpio39=%u)\n", tsp.last_irq, tsp_gpio_in(39));
+			return;
+		}
+	}
+	tsp.xmax = xmax;
+	tsp.ymax = ymax;
+	printf("SWEET TOUCH(apollo): fw=%#x xmax=%u ymax=%u\n", ver, xmax, ymax);
+	tsp.up = true;
+	kern_return_t kr = kernel_thread_start(tsp_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH(apollo): kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
