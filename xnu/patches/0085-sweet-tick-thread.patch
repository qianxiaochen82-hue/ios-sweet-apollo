 	IOLog("SWEET HID: touch registered\n");
+	/*
+	 * Liveness probe independent of any IOKit work loop.  The buttons
+	 * timer never fired on kona (193d7b9 / 3eb7cac runs: zero SWEET HB),
+	 * so this kernel thread reports every 3 s if the scheduler runs.
+	 */
+	{
+		thread_t th;
+
+		if (kernel_thread_start(sweetTickThread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			IOLog("SWEET PROBE: tick thread start failed\n");
+		}
+	}
