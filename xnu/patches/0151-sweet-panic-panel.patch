 	}
 }
 
+/*
+ * 0151: panic path that the console lock cannot block.
+ *
+ * The 0150 run ended with no panic text and with the 1 Hz paint thread also
+ * stopped, i.e. every CPU stopped.  A panic whose kprintf() cannot take
+ * console_lock looks exactly like that, so panic() calls this before anything
+ * else: it draws a band and renders one line into our own text slots, both of
+ * which only touch the framebuffer and take no locks.
+ *
+ *   kind 0 panic (magenta), 1 debugger (blue), 2 halt (red)
+ */
+void
+sweet_panic_begin(unsigned kind, const char *msg)
+{
+	static char buf[220];
+	unsigned n = sweet_sc_total;
+	uint32_t color = (kind == 0) ? 0xffff00ffu :
+	    (kind == 1) ? 0xff00a0ffu : 0xffff0000u;
+
+	sweet_fill(0, 760, 1440, 56, color);
+	snprintf(buf, sizeof(buf), "%s: %.78s SC n=%u %u %u %u %u %u %u %u",
+	    kind == 0 ? "PANIC" : (kind == 1 ? "DEBUGGER" : "HALT"),
+	    msg ? msg : "", n,
+	    n > 0 ? sweet_sc_ring[(n - 1) & 7u] : 0,
+	    n > 1 ? sweet_sc_ring[(n - 2) & 7u] : 0,
+	    n > 2 ? sweet_sc_ring[(n - 3) & 7u] : 0,
+	    n > 3 ? sweet_sc_ring[(n - 4) & 7u] : 0,
+	    n > 4 ? sweet_sc_ring[(n - 5) & 7u] : 0,
+	    n > 5 ? sweet_sc_ring[(n - 6) & 7u] : 0,
+	    n > 6 ? sweet_sc_ring[(n - 7) & 7u] : 0,
+	    n > 7 ? sweet_sc_ring[(n - 8) & 7u] : 0);
+	sweet_status(buf);
+}
+
 static void
 sweet_hb_start(void)
 {
