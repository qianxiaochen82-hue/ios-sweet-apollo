 }
+
+/*
+ * 0139: a second, deliberately boring liveness beacon.
+ *
+ * The 0090 stage thread is not a trustworthy "is the kernel alive" probe: at
+ * tick 6 it calls sweet_usb_probe(), which is known to block in
+ * DEPCMD_STARTTRANSFER, so that thread goes silent 30 s in no matter what the
+ * rest of the kernel is doing.
+ *
+ * This thread touches nothing but printf: no IOKit, no workloop, no timer
+ * event source, no UFS, no USB, no sweet_log_append. It only reads the stage
+ * counter that bsd_init already maintains. If the screen keeps showing this
+ * line, the scheduler and the console path are alive; if it stops while other
+ * output continues, only this thread is stuck.
+ */
+static void
+sweet_hb_thread(void *arg, wait_result_t wres)
+{
+	unsigned tick = 0;
+
+	(void)arg;
+	(void)wres;
+	for (;;) {
+		IOSleep(5000);
+		tick++;
+		printf("SWEET HB2 %u stage=%u\n", tick, sweet_stamp_stage);
+	}
+}
+
+static void
+sweet_hb_start(void)
+{
+	thread_t th = THREAD_NULL;
+	int on = 0;
+
+	PE_parse_boot_argn("sweethb", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	if (kernel_thread_start(sweet_hb_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
