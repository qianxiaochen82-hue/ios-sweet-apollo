--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -123,6 +123,10 @@ sweet_usb_probe(void)
 
 	/* sweetusb=0 off, 1 (default) report state only, 2 also start the USB device */
 	PE_parse_boot_argn("sweetusb", &enabled, sizeof(enabled));
+	/* screen tag, so a photograph can be attributed to one build */
+	printf("SWEET USB: build 0120\n");
+	sweet_note(0, "USB build 0120");
+	sweet_note(1, "USB: probing");
 	if (!enabled) {
 		return;
 	}
