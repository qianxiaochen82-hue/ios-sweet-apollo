diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 5e95078..ef64824 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -492,6 +492,20 @@ bsd_init(void)
 
 	printf("SWEET PROBE: bsd_init enter\n");
 
+	/*
+	 * VM and pmap are up here, so the apollo keys/touch bring-up can run.
+	 * Each step prints, so a hang is visible on the console.
+	 */
+	{
+		extern void apollo_keys_init(void);
+		extern void apollo_touch_init(void);
+
+		printf("SWEET PROBE: apollo input init begin\n");
+		apollo_keys_init();
+		apollo_touch_init();
+		printf("SWEET PROBE: apollo input init done\n");
+	}
+
 #define DEBUG_BSDINIT 1
 
 #if DEBUG_BSDINIT
