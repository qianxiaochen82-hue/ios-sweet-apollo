+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Drawn straight into the boot framebuffer by bsd/kern/bsd_init.c.
+ * The kprintf/console path stops reaching the framebuffer, this does not. */
+extern "C" void sweet_fb_mark(const char * tag);
+
+/* "tag name", truncated to one banner line worth of characters */
+static void
+sweet_mark_pair(const char * tag, const char * name)
+{
+	char buf[48];
+	char * d = buf;
+	unsigned n = 0;
+
+	while (*tag != '\0' && n < 24) {
+		*d++ = *tag++;
+		n++;
+	}
+	if (name != NULL) {
+		*d++ = ' ';
+		n++;
+		while (*name != '\0' && n < 44) {
+			*d++ = *name++;
+			n++;
+		}
+	}
+	*d = '\0';
+	sweet_fb_mark(buf);
+}
+#else
+static inline void sweet_fb_mark(const char * tag) { (void)tag; }
+static inline void sweet_mark_pair(const char * tag, const char * name)
+{
+	(void)tag;
+	(void)name;
+}
+#endif
