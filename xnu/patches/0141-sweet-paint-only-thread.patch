diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index c651c26..65fd681 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -941,6 +941,41 @@ sweet_stage_heartbeat(void)
  * line, the scheduler and the console path are alive; if it stops while other
  * output continues, only this thread is stuck.
  */
+static void
+sweet_paint_thread(void *arg, wait_result_t wres)
+{
+	unsigned tick = 0;
+
+	(void)arg;
+	(void)wres;
+	for (;;) {
+		unsigned b;
+		uint32_t color;
+
+		IOSleep(1000);
+		tick++;
+		color = (tick & 1u) ? 0xff00ffffu : 0xffff0000u;
+		for (b = 0; b < 16; b++) {
+			sweet_stamp_block_at(7, b, color);
+		}
+	}
+}
+
+static void
+sweet_paint_start(void)
+{
+	thread_t th = THREAD_NULL;
+	int on = 0;
+
+	PE_parse_boot_argn("sweethb", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	if (kernel_thread_start(sweet_paint_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+}
+
 static void
 sweet_hb_thread(void *arg, wait_result_t wres)
 {
@@ -976,6 +1011,7 @@ sweet_hb_start(void)
 	if (kernel_thread_start(sweet_hb_thread, NULL, &th) == KERN_SUCCESS) {
 		thread_deallocate(th);
 	}
+	sweet_paint_start();
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
 
