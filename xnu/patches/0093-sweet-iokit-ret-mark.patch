diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index c6da67d..15e83bf 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -433,6 +433,16 @@ kernel_bootstrap(void)
 	kernel_bootstrap_log("vm_mem_bootstrap");
 	vm_mem_bootstrap();
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	{
+		/* now that KMEM (and io_submap, 96MB on SWEET) exists, map the boot
+		 * framebuffer; doing this earlier panicked in pmap_map_bd with
+		 * "no PTE", because the pre-KMEM virtual space has no page tables */
+		extern void sweet_fb_early_init(void);
+		sweet_fb_early_init();
+	}
+#endif
+
 	machine_info.memory_size = (uint32_t)mem_size;
 #if XNU_TARGET_OS_OSX
 	machine_info.max_mem = max_mem_actual;
@@ -705,6 +715,14 @@ kernel_bootstrap_thread(void)
 	kprintf("SWEET STAGE: calling PE_init_iokit\n");
 	PE_init_iokit();
 	kprintf("SWEET STAGE: PE_init_iokit done\n");
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	{
+		/* bsd/kern/bsd_init.c: paints the boot framebuffer directly, so it
+		 * proves readBooterExtensions (called from PE_init_iokit) returned. */
+		extern void sweet_fb_mark(const char * tag);
+		sweet_fb_mark("IOKIT RET");
+	}
+#endif
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
