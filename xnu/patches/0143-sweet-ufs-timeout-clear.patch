+/*
+ * 0143: the UFS driver calls this when a command times out. Row 8 stays empty
+ * while the disk is healthy and grows one red block per fault, so a wedged
+ * disk is visible even with the text console muted.
+ */
+void
+sweet_stamp_ufs_fault(uint32_t n, uint32_t color)
+{
+	uint32_t i;
+
+	for (i = 0; i < n && i < 16; i++) {
+		sweet_stamp_block_at(8, i, color);
+	}
+}
