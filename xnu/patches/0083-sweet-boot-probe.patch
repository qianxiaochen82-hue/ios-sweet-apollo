+	/*
+	 * Always run a 2 s heartbeat so the console shows whether kernel
+	 * timers still fire after the boot appears to stop. Boot-arg
+	 * sweethidtest=N keeps its old meaning (Home key test every N s).
+	 */
+	PE_parse_boot_argn("sweethidtest", &fTestSecs, sizeof(fTestSecs));
+	fTest = IOTimerEventSource::timerEventSource(this, &SweetHIDButtons::testFired);
+	if (fTest && _hidWorkLoop->addEventSource(fTest) == kIOReturnSuccess) {
+		fTest->setTimeoutMS(fTestSecs ? fTestSecs * 1000 : 2000);
