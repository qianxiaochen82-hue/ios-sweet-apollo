diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 77c5e52..f1a2c1e 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1130,15 +1130,18 @@ bsd_init(void)
 #if CONFIG_PROC_UUID_POLICY
 	/* Initial proc_uuid_policy subsystem */
 	bsd_init_kprintf("calling proc_uuid_policy_init()\n");
+	sweet_fb_mark("S3 UUID");
 	proc_uuid_policy_init();
 #endif
 
 #if SOCKETS
 	/* Initialize per-CPU cache allocator */
+	sweet_fb_mark("S3 MCACHE");
 	mcache_init();
 
 	/* Initialize mbuf's. */
 	bsd_init_kprintf("calling mbinit\n");
+	sweet_fb_mark("S3 MBUF");
 	mbinit();
 	restricted_in_port_init();
 #endif /* SOCKETS */
@@ -1149,26 +1152,33 @@ bsd_init(void)
 	 */
 #if CONFIG_AUDIT
 	bsd_init_kprintf("calling audit_init\n");
+	sweet_fb_mark("S3 AUDIT");
 	audit_init();
 #endif
 
 	/* Initialize kqueues */
 	bsd_init_kprintf("calling knote_init\n");
+	sweet_fb_mark("S3 KNOTE");
 	knote_init();
 
 	/* Initialize event handler */
 	bsd_init_kprintf("calling eventhandler_init\n");
+	sweet_fb_mark("S3 EVENT");
 	eventhandler_init();
 
 	/* Initialize for async IO */
 	bsd_init_kprintf("calling aio_init\n");
+	sweet_fb_mark("S3 AIO");
 	aio_init();
 
+	sweet_fb_mark("S3 PTHREAD");
 	pthread_init();
 	/* POSIX Shm and Sem */
 	bsd_init_kprintf("calling pshm_cache_init\n");
+	sweet_fb_mark("S3 PSHM");
 	pshm_cache_init();
 	bsd_init_kprintf("calling psem_cache_init\n");
+	sweet_fb_mark("S3 PSEM");
 	psem_cache_init();
 
 	/*
@@ -1177,14 +1187,18 @@ bsd_init(void)
 	 */
 #if NETWORKING
 	bsd_init_kprintf("calling nwk_wq_init\n");
+	sweet_fb_mark("S3 NWKWQ");
 	nwk_wq_init();
 	bsd_init_kprintf("calling dlil_init\n");
+	sweet_fb_mark("S3 DLIL");
 	dlil_init();
 #endif /* NETWORKING */
 #if SOCKETS
 	bsd_init_kprintf("calling socketinit\n");
+	sweet_fb_mark("S3 SOCKET");
 	socketinit();
 	bsd_init_kprintf("calling domaininit\n");
+	sweet_fb_mark("S3 DOMAIN");
 	domaininit();
 	iptap_init();
 #if FLOW_DIVERT
@@ -1193,13 +1207,16 @@ bsd_init(void)
 #endif /* SOCKETS */
 #if SKYWALK
 	bsd_init_kprintf("calling skywalk_init\n");
+	sweet_fb_mark("S3 SKYWALK");
 	(void) skywalk_init();
 #endif /* SKYWALK */
 #if NETWORKING
 #if NECP
 	/* Initialize Network Extension Control Policies */
+	sweet_fb_mark("S3 NECP");
 	necp_init();
 #endif
+	sweet_fb_mark("S3 NETAGENT");
 	netagent_init();
 #endif /* NETWORKING */
 
@@ -1209,19 +1226,23 @@ bsd_init(void)
 #endif
 	/* Initialise background freezing */
 	bsd_init_kprintf("calling memorystatus_freeze_init\n");
+	sweet_fb_mark("S3 MEMFREEZE");
 	memorystatus_freeze_init();
 #endif
 
 #if CONFIG_MEMORYSTATUS
 	/* Initialize kernel memory status notifications */
 	bsd_init_kprintf("calling memorystatus_init\n");
+	sweet_fb_mark("S3 MEMSTAT");
 	memorystatus_init();
 #endif /* CONFIG_MEMORYSTATUS */
 
 	bsd_init_kprintf("calling sysctl_mib_init\n");
+	sweet_fb_mark("S3 SYSCTLMIB");
 	sysctl_mib_init();
 
 	bsd_init_kprintf("calling bsd_autoconf\n");
+	sweet_fb_mark("S3 AUTOCONF");
 	bsd_autoconf();
 
 #if CONFIG_DTRACE
@@ -1236,6 +1257,7 @@ bsd_init(void)
 #include <loop.h>
 #if NLOOP > 0
 	bsd_init_kprintf("calling loopattach\n");
+	sweet_fb_mark("S3 LOOP");
 	loopattach();                   /* XXX */
 #endif
 #if NGIF
@@ -1251,6 +1273,7 @@ bsd_init(void)
 #if NETHER > 0
 	/* Register the built-in dlil ethernet interface family */
 	bsd_init_kprintf("calling ether_family_init\n");
+	sweet_fb_mark("S3 ETHER");
 	ether_family_init();
 #endif /* ETHER */
 
@@ -1266,6 +1289,7 @@ bsd_init(void)
 	/*
 	 * Register subsystems with kernel control handlers
 	 */
+	sweet_fb_mark("S3 NETCTRL");
 	utun_register_control();
 #if IPSEC
 	ipsec_register_control();
@@ -1286,10 +1310,12 @@ bsd_init(void)
 	 * the clients that are waiting for the networking stack to be usable.
 	 */
 	bsd_init_kprintf("calling net_init_run\n");
+	sweet_fb_mark("S3 NETRUN");
 	net_init_run();
 #endif /* NETWORKING */
 
 	bsd_init_kprintf("calling inittodr\n");
+	sweet_fb_mark("S3 TODR");
 	inittodr(0);
 
 	/* Mount the root file system. */
