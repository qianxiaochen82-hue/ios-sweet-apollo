diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index eb3c9e5..c07c314 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -956,6 +956,24 @@ sweet_stamp_ufs_fault(uint32_t n, uint32_t color)
 	}
 }
 
+/*
+ * 0144: after P 100% (sweet_stage(8)) the boot still has to finish bsd_init,
+ * hand the bootstrap thread to vm_pageout and start process 1.  Row 8 slots
+ * 0-7 stay the UFS fault counters; slots 8-15 are green breadcrumbs, one per
+ * step, so the last lit slot is exactly where the machine stopped:
+ *   8 bsd_init done      9 back in kernel_bootstrap   10 pre vm_pageout
+ *   11 bsdinit_task      12 before load_init_program  13 launchd exec'd
+ *   14 load_init_program returned (should not happen)
+ */
+void
+sweet_stamp_breadcrumb(unsigned step)
+{
+	if (step > 6) {
+		return;
+	}
+	sweet_stamp_block_at(8, 8 + step, 0xff00ff00u);
+}
+
 static void
 sweet_paint_thread(void *arg, wait_result_t wres)
 {
@@ -1716,6 +1734,7 @@ bsd_init(void)
 	machine_timeout_bsd_init();
 #endif /* DEVELOPMENT || DEBUG */
 
+	sweet_stamp_breadcrumb(0);
 	bsd_init_kprintf("done\n");
 }
 
@@ -1724,6 +1743,7 @@ bsdinit_task(void)
 {
 	proc_t p = current_proc();
 
+	sweet_stamp_breadcrumb(3);
 	process_name("init", p);
 
 	/* Set up exception-to-signal reflection */
@@ -1745,7 +1765,9 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	sweet_stamp_breadcrumb(4);
 	load_init_program(p);
+	sweet_stamp_breadcrumb(6);
 	lock_trace = 1;
 }
 
