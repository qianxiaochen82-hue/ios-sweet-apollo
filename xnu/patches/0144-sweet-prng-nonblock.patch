diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index c53d45d..17a73a9 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -155,6 +155,9 @@ static struct {
  */
 #include <kern/startup.h>
 
+/* osfmk/arm/cpu_data.h is not reachable from here */
+extern int get_preemption_level(void);
+
 static LCK_GRP_DECLARE(sweet_prng_group, "sweet-prng");
 static LCK_MTX_DECLARE(sweet_prng_lock, &sweet_prng_group);
 static struct cckprng_ctx sweet_prng_ctx;
@@ -166,6 +169,8 @@ static cckprng_getentropy sweet_getentropy;
 static void *sweet_getentropy_arg;
 static unsigned sweet_max_ngens;
 static bool sweet_generators[MAX_CPUS];
+/* Generations that had to run without the mutex (see sweet_prng_generate). */
+static unsigned sweet_prng_unsafe;
 
 static struct ccdrbg_state *
 sweet_prng_state(struct cckprng_ctx *ctx)
@@ -251,12 +256,30 @@ static void
 sweet_prng_generate(struct cckprng_ctx *ctx, unsigned gen_idx,
     size_t nbytes, void *out)
 {
+	bool locked = false;
+
 	assert(nbytes <= CCKPRNG_GENERATE_MAX_NBYTES);
-	lck_mtx_lock(&sweet_prng_lock);
+	/*
+	 * read_random() reaches this from interrupt and preemption-disabled
+	 * contexts, where a blocking mutex can never be acquired: the caller
+	 * would sit on the CPU with interrupts off waiting for a holder that
+	 * may itself be waiting for that CPU.  Block only where sleeping is
+	 * legal; otherwise try once and generate anyway.
+	 */
+	if (get_preemption_level() == 0) {
+		lck_mtx_lock(&sweet_prng_lock);
+		locked = true;
+	} else if (lck_mtx_try_lock(&sweet_prng_lock)) {
+		locked = true;
+	} else {
+		sweet_prng_unsafe++;
+	}
 	assert(gen_idx < sweet_max_ngens && sweet_generators[gen_idx]);
 	sweet_prng_check(ccdrbg_generate(&ctx->drbg_info, sweet_prng_state(ctx),
 	    nbytes, out, 0, NULL));
-	lck_mtx_unlock(&sweet_prng_lock);
+	if (locked) {
+		lck_mtx_unlock(&sweet_prng_lock);
+	}
 }
 
