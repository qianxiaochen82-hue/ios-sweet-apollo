 	}
 }
 
+/*
+ * 0149: which system call process 1 is sitting in.
+ *
+ * The panel keeps refreshing after the stall (row 7 flips at 1 Hz in every
+ * 100% photo), so the kernel scheduler is still running; it is a user process
+ * that is waiting for something that never comes.  Painting the call number on
+ * every entry means the last number on the panel when everything else stops
+ * moving is the call that never returned.  Only pid 1 is tracked, and only
+ * bits that changed are repainted, so this is a few rectangle fills per call,
+ * takes no locks (same path as the breadcrumb above, already called from
+ * unix_syscall with preemption off).
+ *
+ *   row 5 slots 0-9    syscall number, low 10 bits, blue = 1
+ *   row 5 slots 10-12  last return: 10 zero, 11 data, 12 errno (magenta)
+ *   row 6 slots 2-15   one cyan block per 256 calls (still alive)
+ */
+void
+sweet_syscall_note(unsigned code)
+{
+	static uint32_t last = 0xffffffffu;
+	static unsigned count;
+	unsigned i, bits;
+
+	count++;
+	if ((count & 0xffu) == 0) {
+		unsigned slot = 2u + ((count >> 8) & 0x7u);
+
+		if (slot == 2u) {
+			for (i = 2; i < 16; i++) {
+				sweet_stamp_block_at(6, i, 0xff000000u);
+			}
+		}
+		sweet_stamp_block_at(6, slot, 0xff00ffffu);
+	}
+	if (code == last) {
+		return;
+	}
+	last = code;
+	bits = code & 0x3ffu;
+	for (i = 0; i < 10; i++) {
+		sweet_stamp_block_at(5, i,
+		    (bits & (1u << i)) ? 0xff00a0ffu : 0xff000000u);
+	}
+}
+
+void
+sweet_syscall_ret(int error, uint64_t rval)
+{
+	static unsigned prev = 0xffffffffu;
+	unsigned slot = error ? 12u : (rval ? 11u : 10u);
+	unsigned i;
+
+	if (slot == prev) {
+		return;
+	}
+	prev = slot;
+	for (i = 0; i < 3; i++) {
+		sweet_stamp_block_at(5, 10 + i,
+		    (i == slot - 10u) ? 0xffff00ffu : 0xff000000u);
+	}
+}
+
