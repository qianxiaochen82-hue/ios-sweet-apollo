 }
+
+/*
+ * 0147: everything that writes a DWC3 register runs here, not in bsd_init.
+ * If the core's bus access wedges (0114-0117), only this thread dies and the
+ * boot still reaches user mode, so the run always yields evidence.
+ */
+static void
+sweet_usb_gadget_thread(void *arg, wait_result_t wr __unused)
+{
+	vm_offset_t dwc = (vm_offset_t)arg;
+	int delay_ms = 8000;
+	int net = 0;
+
+	PE_parse_boot_argn("sweetusbdelay", &delay_ms, sizeof(delay_ms));
+	if (delay_ms > 0) {
+		ud_sleep_ms((unsigned)delay_ms);
+	}
+	/*
+	 * Power domain and clocks again, immediately before the first write:
+	 * if they went away between the probe and now, this line says so and
+	 * the wedge below is explained.
+	 */
+	sweet_usb_power_report("pre-start");
+	sweet_usb_gadget_start(dwc);
+
+	PE_parse_boot_argn("sweetusbnet", &net, sizeof(net));
+	if (!net || ud.ifp != NULL) {
+		return;
+	}
+	/*
+	 * ue0 needs the network stack bsd_init is still building, and dlil
+	 * faults when the ifnet is created before it is ready (0112), so wait
+	 * until bsd_init has had time to finish before creating it.
+	 */
+	delay_ms = 15000;
+	PE_parse_boot_argn("sweetusbnetdelay", &delay_ms, sizeof(delay_ms));
+	if (delay_ms > 0) {
+		ud_sleep_ms((unsigned)delay_ms);
+	}
+	printf("SWEET USB: creating ethernet interface\n");
+	sweet_note(0, "USB: net create");
+	ud_if_create();
+}
+
+static void
+sweet_usb_power_report(const char *tag)
+{
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+
+	if (gcc == 0) {
+		printf("SWEET USB: %s GCC map failed\n", tag);
+		return;
+	}
+	printf("SWEET USB: %s GDSC 0x%08x master 0x%08x cfg-noc 0x%08x ahb2phy 0x%08x\n", tag,
+	    usb_rd(gcc, GCC_USB30_PRIM_GDSCR), usb_rd(gcc, usb_cbcr[0].off),
+	    usb_rd(gcc, usb_cbcr[3].off), usb_rd(gcc, usb_cbcr[5].off));
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
