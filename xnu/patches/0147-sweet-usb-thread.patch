 	/*
 	 * Device controller soft reset (PHY and global setup stay as ABL left
@@ -1121,8 +1129,65 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	}
 	int livelog = 1;
 	PE_parse_boot_argn("sweetusblog", &livelog, sizeof(livelog));
-	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+	if (livelog && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
