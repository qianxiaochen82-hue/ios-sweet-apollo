diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index f9e2130..54eac37 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -585,6 +585,70 @@ static const struct cdevsw sweet_ufs_cdevsw = {
 	.d_type       = D_DISK,
 };
 
+/*
+ * Read-only probe, run after init is up (boot-arg sweetufs=1).
+ * It maps the controller, takes the host over, sends a TUR and validates the
+ * GPT, then returns without registering a bdevsw node or starting anything.
+ * Every step prints first, so a hang shows exactly where it happened.
+ */
+void
+sweet_ufs_probe_readonly(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	printf("SWEET UFS: probe begin (post-init, read-only)\n");
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET UFS: probe: no /sweet-ufs node\n");
+		return;
+	}
+	printf("SWEET UFS: probe: before ml_io_map\n");
+	su.regs = ml_io_map(reg[0], reg[1]);
+	printf("SWEET UFS: probe: regs 0x%llx\n", (unsigned long long)su.regs);
+	if (!su.regs) {
+		return;
+	}
+	printf("SWEET UFS: probe: before DMA alloc\n");
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET UFS: probe: no contiguous DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		printf("SWEET UFS: probe: no phys for DMA\n");
+		return;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+	printf("SWEET UFS: probe: before host takeover\n");
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	printf("SWEET UFS: probe: takeover rc=%d\n", error);
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+		printf("SWEET UFS: probe: TUR rc=%d\n", error);
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+		printf("SWEET UFS: probe: GPT rc=%d\n", error);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (!error) {
+		printf("SWEET UFS: probe: \"%s\" first block 0x%llx, %llu MiB (read-only)\n",
+		    want, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	}
+	printf("SWEET UFS: probe done\n");
+}
